{
  "name": "electron",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "pnpm run build:native && vite build && vite build --config vite.electron.config.ts && tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:main": "node scripts/smoke-electron-main-cjs.mjs",
    "build:native": "node scripts/build-native-helpers.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "catalog:",
    "vitest": "^4.0.15"
  }
}
