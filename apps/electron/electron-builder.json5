{
  appId: "app.glide.desktop",
  productName: "Glide",
  directories: {
    output: "release"
  },
  files: [
    "dist/**",
    "dist-electron/**",
    "electron/native/bin/**",
    "package.json"
  ],
  asarUnpack: [
    "electron/native/bin/**"
  ],
  mac: {
    icon: "build/icon.icns",
    category: "public.app-category.productivity",
    extendInfo: {
      NSMicrophoneUsageDescription: "Glide uses the microphone for push-to-talk voice dictation."
    },
    target: [
      { target: "dmg", arch: ["arm64", "x64"] },
      { target: "zip", arch: ["arm64", "x64"] }
    ],
    entitlements: "build/entitlements.mac.plist",
    entitlementsInherit: "build/entitlements.mac.inherit.plist",
    hardenedRuntime: true
  },
  win: {
    icon: "build/icon.ico",
    target: [
      { target: "nsis", arch: ["x64"] }
    ]
  },
  linux: null
}
